// custom-kbr: 3D-printable tray-mount case + switch plate (OpenSCAD 2021.01+)
//
// The PCB screws onto 6 standoffs in the case tray (M2, heat-set inserts or self-tapping).
// The switch plate is optional and floats on the switches (it is not screwed down); it keeps
// hotswap switches from coming out with the keycaps.
//
// Board geometry comes from kbr_data.scad (generated by scripts/gen_case_data.py).
// Case coordinates: origin = front-left PCB corner, Y towards the back (USB edge),
// z = 0 on the floor top under the PCB, PCB parallel to the XY plane. The bottom of the
// case is tilted by typing_angle; parts are rotated onto that face for printing.
//
// Export one part at a time, e.g.
//   openscad -D 'part="print_case_left"' -o case_left.stl case.scad

include <kbr_data.scad>

/* [Part] */
part = "assembly"; // [assembly, case, case_left, case_right, plate, plate_left, plate_right, print_case_left, print_case_right, print_plate_left, print_plate_right]

/* [Case] */
wall = 3.5;              // side wall thickness
gap = 0.6;               // PCB edge to inner wall
floor_t = 3;             // floor thickness at the front edge (thicker towards the back)
standoff_h = 4.5;        // floor top to PCB bottom: hotswap sockets 1.8 mm, USB-C receptacle 3.26 mm
pcb_t = 1.6;
plate_top = 5;           // MX spec: plate top surface 5 mm above the PCB top
rim_above_plate = 0;     // raise the rim above the plate top (0 = flush)
corner_r = 4;            // outer corner radius
typing_angle = 6;        // degrees; 0 = flat case

/* [Screws] */
screw_mode = "insert";   // [insert, selftap]
insert_hole_d = 3.2;     // M2 heat-set insert (OD ~3.5 mm, 3-4 mm long)
insert_hole_depth = 5;
selftap_hole_d = 1.7;    // M2 screw cut straight into the plastic
standoff_d = 5;          // free radius around the holes on the PCB bottom is 2.54 mm
standoff_base_d = 9;     // wider foot, below the bottom-side parts
part_clearance_h = 2.2;  // tallest bottom-side part near the holes (socket 1.8 mm) + margin

/* [USB-C opening] */
usb_cut_w = 13;          // fits most cable overmolds (~12 x 6.5 mm)
usb_cut_h = 7.5;
usb_body_h = 3.26;       // receptacle height below the PCB

/* [Reset button] */
reset_hole_d = 3;        // paperclip access through the floor

/* [Rubber feet] */
foot_d = 10.5;           // recess for 10 mm stick-on bumpers
foot_depth = 1;
foot_inset = 14;

/* [Split for small print beds] */
split = true;            // the case is ~312 mm wide; split it into two halves
split_x = 160;           // PCB x of the cut (clear of standoffs, USB and reset)
dovetail_ys = [16, 40, 63, 87];
dovetail_len = 8;
dovetail_neck = 8;
dovetail_head = 12;
fit = 0.2;               // total clearance in the dovetail joint

/* [Plate] */
plate_t = 1.5;           // MX switches clip into 1.5 mm
plate_inset = 0.3;       // plate outline inset from the PCB outline
switch_cut = 14;
stab_cut_w = 7.2;        // PCB-mount stabilizer housings pass through the plate
stab_cut_h = 16;
stab_cut_dy = -0.6;      // housing centre relative to the switch centre (towards the front)
plate_split_gap = 0.3;

$fn = 48;

// ---- derived ----------------------------------------------------------------
pcb_top = standoff_h + pcb_t;
plate_z = pcb_top + plate_top - plate_t;
rim_z = pcb_top + plate_top + rim_above_plate;
edge = gap + wall;                         // PCB edge to outer wall
case_d = PCB_H + 2 * edge;
y_front = -edge;
drop = case_d * tan(typing_angle);         // extra height at the back
big = floor_t + drop + 10;

// ---- 2D shapes --------------------------------------------------------------
module rounded_rect(w, h, r) {
    if (r > 0) translate([r, r]) offset(r = r) square([w - 2 * r, h - 2 * r]);
    else square([w, h]);
}

module pcb2d(o = 0) {   // PCB outline grown by o
    translate([-o, -o]) rounded_rect(PCB_W + 2 * o, PCB_H + 2 * o, max(PCB_R + o, 0));
}

module outer2d() {
    translate([-edge, -edge]) rounded_rect(PCB_W + 2 * edge, PCB_H + 2 * edge, corner_r);
}

// ---- case -------------------------------------------------------------------
// Frame whose XY plane is the desk (bottom face of the case), pivoting on the front edge.
module desk_frame() {
    translate([0, y_front, -floor_t]) rotate([-typing_angle, 0, 0]) children();
}

// Inverse of desk_frame: puts the case bottom on z = 0 (desk / print bed).
module on_desk() {
    rotate([typing_angle, 0, 0]) translate([0, -y_front, floor_t]) children();
}

module standoff() {
    cylinder(d = standoff_d, h = standoff_h);
    cylinder(d = standoff_base_d, h = standoff_h - part_clearance_h);
    translate([0, 0, standoff_h - part_clearance_h])   // 45° transition, no overhang
        cylinder(d1 = standoff_base_d, d2 = standoff_d, h = (standoff_base_d - standoff_d) / 2);
}

module screw_hole() {
    if (screw_mode == "insert")
        translate([0, 0, standoff_h - insert_hole_depth]) cylinder(d = insert_hole_d, h = insert_hole_depth + 1);
    else
        translate([0, 0, standoff_h - 9]) cylinder(d = selftap_hole_d, h = 10);
}

module case_body() {
    difference() {
        union() {
            difference() {
                intersection() {
                    translate([0, 0, -big]) linear_extrude(big + rim_z) outer2d();
                    desk_frame() translate([-50, -50, 0]) cube([PCB_W + 100, case_d + 100, big + rim_z + 50]);
                }
                linear_extrude(rim_z + 1) pcb2d(gap);   // tray
            }
            for (h = PCB_HOLES) translate([h[0], h[1], -0.01]) standoff();
        }
        for (h = PCB_HOLES) translate([h[0], h[1], 0]) screw_hole();

        // USB-C opening in the back wall, centred on the receptacle
        translate([USB_X, PCB_H + gap - 1, standoff_h - usb_body_h / 2]) rotate([-90, 0, 0])
            linear_extrude(wall + 2) translate([-usb_cut_w / 2, -usb_cut_h / 2])
                rounded_rect(usb_cut_w, usb_cut_h, 2);

        // reset button access, countersunk on the outside so a paperclip finds it
        translate([RESET_POS[0], RESET_POS[1], -big]) cylinder(d = reset_hole_d, h = big + 1);
        desk_frame() translate([RESET_POS[0], RESET_POS[1] - y_front, -0.01])
            cylinder(d1 = reset_hole_d + 3, d2 = reset_hole_d, h = 1.5);

        // rubber feet
        desk_len = case_d / cos(typing_angle);
        for (x = [-edge + foot_inset, PCB_W / 2, PCB_W + edge - foot_inset],
             y = [foot_inset, desk_len - foot_inset])
            desk_frame() translate([x, y, -1]) cylinder(d = foot_d, h = foot_depth + 1);
    }
}

// Left half's footprint: everything left of split_x plus dovetail tabs. o grows it.
module left_region(o) {
    translate([-100, -100]) square([split_x + 100 + o, PCB_H + 200]);
    for (y = dovetail_ys) translate([split_x, y]) offset(delta = o)
        polygon([[-1, -dovetail_neck / 2], [dovetail_len, -dovetail_head / 2],
                 [dovetail_len, dovetail_head / 2], [-1, dovetail_neck / 2]]);
}

module case_left() {
    intersection() {
        case_body();
        translate([0, 0, -big - 1]) linear_extrude(big + rim_z + 2) left_region(-fit / 2);
    }
}

module case_right() {
    difference() {
        case_body();
        translate([0, 0, -big - 1]) linear_extrude(big + rim_z + 2) left_region(fit / 2);
    }
}

// ---- plate ------------------------------------------------------------------
module plate2d() {
    difference() {
        pcb2d(-plate_inset);
        for (k = KEYS) {
            translate([k[0], k[1]]) square(switch_cut, center = true);
            if (k[4] > 0) for (s = [-1, 1])
                translate([k[0] + s * k[4], k[1] + stab_cut_dy * k[5]]) square([stab_cut_w, stab_cut_h], center = true);
        }
    }
}

// Plate halves follow key boundaries, so every switch sits entirely in one half and each
// half is held by its own switches (no joint needed).
module key_cell(k) {
    x0 = k[0] - k[2] * KEY_U / 2; x1 = k[0] + k[2] * KEY_U / 2;
    y0 = k[1] - KEY_U / 2;        y1 = k[1] + KEY_U / 2;
    ex0 = x0 < 0.1 ? 30 : 0;      ex1 = x1 > PCB_W - 0.1 ? 30 : 0;
    ey0 = k[3] == 4 ? 30 : 0;     ey1 = k[3] == 0 ? 30 : 0;
    e = 0.01;  // overlap neighbours so the union has no slivers
    translate([x0 - ex0 - e, y0 - ey0 - e]) square([x1 - x0 + ex0 + ex1 + 2 * e, y1 - y0 + ey0 + ey1 + 2 * e]);
}

module plate_left_region(o) {
    offset(delta = o) for (k = KEYS) if (k[0] < split_x) key_cell(k);
}

module plate_left() {
    linear_extrude(plate_t) intersection() { plate2d(); plate_left_region(-plate_split_gap / 2); }
}

module plate_right() {
    linear_extrude(plate_t) difference() { plate2d(); plate_left_region(plate_split_gap / 2); }
}

module plate() { linear_extrude(plate_t) plate2d(); }

// ---- assembly preview -------------------------------------------------------
module pcb_mock() {
    color("darkgreen") translate([0, 0, standoff_h]) linear_extrude(pcb_t) difference() {
        pcb2d();
        for (h = PCB_HOLES) translate(h) circle(d = 2.2);
    }
    // USB-C receptacle
    color("silver") translate([USB_X - 4.47, USB_MOUTH_Y - 7.3, standoff_h - usb_body_h]) cube([8.94, 7.3, usb_body_h]);
}

module switches() {   // MX top housings above the plate
    color("black") for (k = KEYS) translate([k[0], k[1], pcb_top + plate_top])
        linear_extrude(5.5, scale = 10 / 15) square(15, center = true);
}

module keycaps() {
    color("ivory", 0.9) for (k = KEYS)
        translate([k[0], k[1], pcb_top + plate_top + 6.5])
            linear_extrude(7, scale = [(k[2] * KEY_U - 6) / (k[2] * KEY_U - 0.8), 12 / 18.25])
                square([k[2] * KEY_U - 0.8, 18.25], center = true);
}

module assembly() {
    on_desk() {
        if (split) {
            color("slategray") case_left();
            color("lightslategray") case_right();
        } else color("slategray") case_body();
        pcb_mock();
        color("dimgray") translate([0, 0, plate_z]) plate();
        switches();
        keycaps();
    }
}

// ---- part selector ----------------------------------------------------------
if (part == "assembly") assembly();
else if (part == "case") case_body();
else if (part == "case_left") case_left();
else if (part == "case_right") case_right();
else if (part == "plate") plate();
else if (part == "plate_left") plate_left();
else if (part == "plate_right") plate_right();
else if (part == "print_case_left") on_desk() case_left();
else if (part == "print_case_right") on_desk() case_right();
else if (part == "print_plate_left") plate_left();
else if (part == "print_plate_right") plate_right();
